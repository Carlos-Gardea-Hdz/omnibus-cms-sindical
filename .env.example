# ==============================================================================
# Corporate CMS — Environment Template
# Copy to .env and run `php artisan key:generate`. Values below match
# docker-compose.dev.yml for local development.
# ==============================================================================

APP_NAME="Corporate CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# --- Logging ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database: PostgreSQL 18 --------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=corporate_cms
DB_USERNAME=corporate_cms
DB_PASSWORD=secret

# --- Cache / Queue / Sessions: Valkey 8.0 (Redis-compatible) ------------------
# Valkey speaks the Redis protocol; Laravel's redis driver connects unchanged.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120          # 120 min — matches AUTH-01

# --- Full-text search: Meilisearch (Laravel Scout) ----------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey

# --- Mail: Mailpit in dev -----------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@cms.carlosgardea.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Filesystem / image storage ----------------------------------------------
FILESYSTEM_DISK=local

# --- Frontend (Vite / Inertia) ------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# --- Demo mode (AUTH-02, §13) -------------------------------------------------
DEMO_MODE_ENABLED=true
DEMO_SESSION_TTL=30           # minutes
